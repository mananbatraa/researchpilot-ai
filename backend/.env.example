GEMINI_API_KEY=replace_me
TAVILY_API_KEY=replace_me
GEMINI_MODEL=gemini-2.5-flash

# Comma-separated origins allowed to call the API (no trailing slash).
# Add your deployed frontend URL, e.g. https://researchpilot.vercel.app
CORS_ORIGINS=http://localhost:5173
# Optional regex for extra origins, e.g. Vercel preview URLs:
# CORS_ORIGIN_REGEX=https://researchpilot-.*\.vercel\.app
