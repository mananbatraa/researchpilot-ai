# URL of the deployed FastAPI backend (no trailing slash).
# Locally this defaults to http://localhost:8000 if left unset.
VITE_API_URL=http://localhost:8000

# Set to 1 to run the UI on its own with a canned sample run (no backend, no API keys).
# Handy for a free static preview on Vercel/Netlify.
VITE_DEMO_MODE=0
